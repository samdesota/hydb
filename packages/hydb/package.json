{
  "name": "@438d/hydb",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "require": "./dist-cjs/src/index.js",
      "import": "./dist/src/index.js"
    },
    "./node": {
      "types": "./dist/src/node/index.d.ts",
      "require": "./dist-cjs/src/node/index.js",
      "import": "./dist/src/node/index.js"
    }
  },
  "scripts": {
    "build": "tsc && npm run build:cjs",
    "build:cjs": "esbuild src/*.ts src/node/*.ts --platform=node --format=cjs --outbase=. --outdir=dist-cjs --packages=external && cp cjs.package.json dist-cjs/package.json",
    "sandbox": "npm run sandbox:query-planner",
    "sandbox:query-planner": "npm run build && node sandboxes/query-planner/generate.mjs",
    "migration": "node scripts/migration-cli.mjs",
    "test": "npm run typecheck && npm run build && node --test dist/test/*.test.js",
    "test:coverage": "npm run build && node --experimental-test-coverage --test --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=95 dist/test/*.test.js",
    "typecheck": "tsc --noEmit",
    "bench:storage": "npm run build && node benchmarks/storage.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "lmdb": "3.5.6",
    "zod": "^4.4.3"
  },
  "description": "Typed real-time database with incremental queries, live subscriptions, and persistent storage.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samdesota/hydb.git",
    "directory": "packages/hydb"
  },
  "homepage": "https://github.com/samdesota/hydb/tree/main/packages/hydb#readme",
  "bugs": {
    "url": "https://github.com/samdesota/hydb/issues"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/src",
    "dist-cjs/src",
    "dist-cjs/package.json",
    "skills"
  ]
}
