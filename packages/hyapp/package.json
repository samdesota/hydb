{
  "name": "@438d/hyapp",
  "version": "0.1.2",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./compiler": {
      "types": "./dist/src/compiler.d.ts",
      "import": "./dist/src/compiler.js"
    },
    "./esbuild": {
      "types": "./dist/src/esbuild.d.ts",
      "import": "./dist/src/esbuild.js"
    },
    "./http": {
      "types": "./dist/src/http.d.ts",
      "import": "./dist/src/http.js"
    },
    "./node": {
      "types": "./dist/src/node/index.d.ts",
      "import": "./dist/src/node/index.js"
    },
    "./solid": {
      "types": "./dist/src/solid.d.ts",
      "import": "./dist/src/solid.js"
    },
    "./wire": {
      "types": "./dist/src/wire.d.ts",
      "import": "./dist/src/wire.js"
    }
  },
  "scripts": {
    "build": "npm run build:hydb && tsc",
    "build:hydb": "npm run build --workspace @438d/hydb",
    "test": "npm run build:hydb && tsc --noEmit && tsc && node --conditions=browser --test dist/test/*.test.js",
    "typecheck": "npm run build:hydb && tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@438d/hydb": "^0.2.0",
    "zod": "^4.4.3",
    "@babel/generator": "^8.0.0",
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^8.0.4"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0",
    "esbuild": "^0.28.2"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "solid-js": "^1.9.15",
    "typescript": "^7.0.2"
  },
  "description": "Commands, gateways, HTTP transport, and optional SolidJS bindings for HyDB.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samdesota/hydb.git",
    "directory": "packages/hyapp"
  },
  "homepage": "https://github.com/samdesota/hydb/tree/main/packages/hyapp#readme",
  "bugs": {
    "url": "https://github.com/samdesota/hydb/issues"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/src",
    "usage.md",
    "docs/commands.md",
    "skills"
  ]
}
